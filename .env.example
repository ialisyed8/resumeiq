# =============================================================================
# ResumeIQ configuration
#
# Copy to .env and fill in. Never commit .env — it is in .gitignore.
# The application validates these at startup and refuses to boot in production
# with placeholder secrets.
# =============================================================================

APP_ENV=development                  # development | staging | production | test
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console                   # console for local, json in production

# --- Secrets -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_48_byte_urlsafe_token
JWT_SECRET=CHANGE_ME_generate_a_different_48_byte_token

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false                  # MUST be true in production
COOKIE_SAMESITE=lax

# --- CORS --------------------------------------------------------------------
# Comma separated. A wildcard is rejected in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://resumeiq:resumeiq@localhost:5432/resumeiq
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Object storage ----------------------------------------------------------
# MinIO locally; point at AWS S3 in production and leave S3_ENDPOINT empty.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=resumeiq-documents
S3_REGION=us-east-1
S3_USE_SSL=false

# --- Anthropic ---------------------------------------------------------------
# Without this the app runs in seeded-demo mode: the UI works, but requirement
# extraction and evidence verification are disabled. Get a key at
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model selection is configuration, not code. Change these without touching
# application logic. A smaller model handles bulk extraction; a larger one
# adjudicates ambiguous evidence.
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VERIFICATION_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_RETRIES=4
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_ENABLE_PROMPT_CACHE=true

# --- Embeddings --------------------------------------------------------------
# Embeddings retrieve candidate evidence; they never produce a score.
# If you change the model you must also change EMBEDDING_DIMENSIONS and
# re-run the migration that sizes the pgvector column.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSIONS=768
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SIMILARITY=0.50

# --- Cost and abuse controls -------------------------------------------------
MAX_UPLOAD_BYTES=10485760            # 10 MB
MAX_RESUME_PAGES=20
MAX_CANDIDATES_PER_SCREENING=500
VERIFICATION_BATCH_SIZE=12
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Extraction --------------------------------------------------------------
EXTRACTION_CONFIDENCE_THRESHOLD=0.55
OCR_ENABLED=true
OCR_DPI=300
OCR_LANGUAGES=eng
LIBREOFFICE_BIN=soffice
VISION_OCR_FALLBACK=false            # costs more per page; enable if OCR is poor

# --- Malware scanning --------------------------------------------------------
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
# Blank = fail closed in production, fail open in development. Setting this to
# true in production accepts unscanned uploads during a scanner outage; that is
# a deliberate risk decision and it is logged when it happens.
CLAMAV_FAIL_OPEN=

# --- Privacy -----------------------------------------------------------------
DEFAULT_BLIND_SCREENING=true         # leave on
DATA_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=2555            # 7 years

# --- Frontend ----------------------------------------------------------------
VITE_API_BASE=/api
